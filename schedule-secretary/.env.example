# データベース
DATABASE_URL=postgresql://user:password@localhost:5432/schedule_secretary

# セッション署名鍵(必須・ランダムな長い文字列)
SESSION_SECRET=change-me-to-a-long-random-string

# 承認者(代表者)ユーザーの初期作成用
ADMIN_EMAIL=mt.kougyou2021@gmail.com
ADMIN_PASSWORD=change-me
ADMIN_NAME=代表者

# AI解析プロバイダ: openai / mock(開発用ルールベース)
AI_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Googleカレンダー: real / mock(開発用)
GOOGLE_CALENDAR_MODE=real
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
GOOGLE_CALENDAR_ID=primary

# LINE連携(第3段階)
# LINE Developers の Messaging API チャネルから取得
LINE_CHANNEL_SECRET=
LINE_CHANNEL_ACCESS_TOKEN=
# 承認依頼を送る代表者のLINEユーザーID
LINE_APPROVER_USER_ID=
# LINE通知に入れる承認画面のURL(末尾スラッシュなし)
APP_BASE_URL=https://your-app.up.railway.app

# サーバー
PORT=3000
TZ=Asia/Tokyo
